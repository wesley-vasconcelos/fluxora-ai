# Supabase - Banco de dados para salvar contatos
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# n8n Webhooks - Para receber notificações de novos contatos
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/contact
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat
